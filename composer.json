{
    "name": "phoenix84pl/pphpa",
    "description": "Phoenix PHP Application - szablon aplikacji bazujacy na PPHPC",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "nyholm/psr7-server": "^1.1",
        "phoenix84pl/pphpc": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "Phoenix\\App\\": "src/"
        }
    },
    "repositories": {
        "pphpc": {
            "type": "vcs",
            "url": "https://github.com/phoenix84pl/pphpc"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "php -r \"is_dir('public') || mkdir('public', 0755, true); copy('vendor/phoenix84pl/pphpc/templates/.htaccess', 'public/.htaccess');\"",
            "php -r \"is_dir('public/assets/css') || mkdir('public/assets/css', 0755, true); copy('vendor/phoenix84pl/pphpc/assets/css/core.css', 'public/assets/css/core.css');\"",
            "php -r \"is_dir('public/assets/js') || mkdir('public/assets/js', 0755, true); copy('vendor/phoenix84pl/pphpc/assets/js/jquery.min.js', 'public/assets/js/jquery.min.js'); copy('vendor/phoenix84pl/pphpc/assets/js/core.js', 'public/assets/js/core.js');\""
        ],
        "post-update-cmd": [
            "php -r \"is_dir('public') || mkdir('public', 0755, true); copy('vendor/phoenix84pl/pphpc/templates/.htaccess', 'public/.htaccess');\"",
            "php -r \"is_dir('public/assets/css') || mkdir('public/assets/css', 0755, true); copy('vendor/phoenix84pl/pphpc/assets/css/core.css', 'public/assets/css/core.css');\"",
            "php -r \"is_dir('public/assets/js') || mkdir('public/assets/js', 0755, true); copy('vendor/phoenix84pl/pphpc/assets/js/jquery.min.js', 'public/assets/js/jquery.min.js'); copy('vendor/phoenix84pl/pphpc/assets/js/core.js', 'public/assets/js/core.js');\""
        ]
    }
}